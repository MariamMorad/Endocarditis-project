# Azure OpenAI Configuration
OPENAI_API_KEY=your_azure_openai_api_key_here
OPENAI_BASE_URL=https://ah30309142502238-8748-resource.openai.azure.com/openai/v1
OPENAI_MODEL=o4-mini

# PDF data paths (relative to project root)
PDF_DIR=data/PDFs
PDF_FILES=ESC.pdf,NICE.pdf

# Chunking settings
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Embeddings & Reranker models
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chroma persistence
CHROMA_COLLECTION=clinical_guidelines_v2
CHROMA_PERSIST_DIR=data/chroma_db
