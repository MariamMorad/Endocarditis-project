# انسخ الملف ده باسم .env واملأ القيم بتاعتك
# لا ترفع ملف .env الحقيقي على git أبدًا

GEMINI_API_KEY=ضع_مفتاحك_الجديد_هنا
GEMINI_MODEL=gemini-2.0-flash

# مسارات ملفات الـ PDF (نسبية لمجلد المشروع)
PDF_DIR=data/PDFs
PDF_FILES=ESC.pdf,NICE.pdf

# إعدادات الـ Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# نموذج الـ embeddings
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings

# نموذج الـ reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# اسم الكوليكشن في Chroma
CHROMA_COLLECTION=clinical_guidelines_v2
